{
  "gpu_workflow": ".github/workflows/gpu.yml",
  "host_enforcement_required": true,
  "protected_branches": [
    "master"
  ],
  "required_hooks": {
    "PreToolUse": "bash scripts/guard.sh",
    "PostToolUse": "bash scripts/overgo_post_commit_dispatch.sh",
    "Stop": "bash scripts/overgo_stop_gate.sh",
    "SessionStart": "bash scripts/overgo_doctrine.sh"
  },
  "required_jobs": [
    "unit",
    "race"
  ],
  "version": 1,
  "workflow": ".github/workflows/test.yml"
}
