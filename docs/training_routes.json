{
  "version": 1,
  "doctrine": "Model facts live in declarations: each route maps an architecture the model input itself declares (GGUF general.architecture, config.json model_type, or a checkpoint file form) to the production trainer that owns it, with the bounded recorded invocation the trainer's verification run established. The lane substitutes only recorded facts: {input} is the model's recorded weights path, {store} the OvergoDB root, {out} the fresh checkpoint directory the lane allots the step, and {t2v-dir} the unique recorded t2v video-stack directory a raw DiT checkpoint conditions on. Architectures without a route train through the dense workflow when their input is a dense representation, and are refused by name otherwise.",
  "routes": {
    "dir:t2v": {
      "trainer": "train -route dit",
      "argv": [
        "go",
        "run",
        "./cmd/train",
        "-route",
        "dit",
        "-store",
        "{store}",
        "-out",
        "{out}",
        "-model-dir",
        "{input}",
        "-schedule-index",
        "0",
        "-steps",
        "3",
        "-max-wall",
        "60m"
      ]
    },
    "dir:unified_mot": {
      "trainer": "train -route mot",
      "argv": [
        "go",
        "run",
        "./cmd/train",
        "-route",
        "mot",
        "-store",
        "{store}",
        "-out",
        "{out}",
        "-model",
        "{input}",
        "-fixtures",
        "C:/Users/jeffm/adaptive_new/fixtures",
        "-binding",
        "rxbrain",
        "-steps",
        "3",
        "-max-wall",
        "30m"
      ]
    },
    "file:pt": {
      "trainer": "train -route dit",
      "argv": [
        "go",
        "run",
        "./cmd/train",
        "-route",
        "dit",
        "-store",
        "{store}",
        "-out",
        "{out}",
        "-model-dir",
        "{t2v-dir}",
        "-checkpoint",
        "{input}",
        "-schedule-index",
        "0",
        "-steps",
        "3",
        "-max-wall",
        "60m"
      ]
    },
    "gguf:gemma4": {
      "trainer": "train -route e4b",
      "argv": [
        "go",
        "run",
        "./cmd/train",
        "-route",
        "e4b",
        "-store",
        "{store}",
        "-model",
        "{input}",
        "-out",
        "{out}",
        "-dataset",
        "docs/verification/e4b-adapter-training-dataset.txt",
        "-steps",
        "3",
        "-max-wall",
        "60m"
      ]
    },
    "gguf:qwen35": {
      "trainer": "train -route hybrid-stack",
      "argv": [
        "go",
        "run",
        "./cmd/train",
        "-route",
        "hybrid-stack",
        "-store",
        "{store}",
        "-model",
        "{input}",
        "-out",
        "{out}",
        "-lane",
        "layer-streamed",
        "-steps",
        "3",
        "-max-wall",
        "120m"
      ],
      "env": {
        "GOGC": "50",
        "GOMEMLIMIT": "68GiB"
      }
    }
  }
}
